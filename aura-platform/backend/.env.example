APP_NAME=AURA Backend
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_IMAGE_NAME=aura-backend:latest
BACKEND_CONTAINER_NAME=aura-backend
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=aura-postgres
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+psycopg://aura:aura@postgres:5432/aura
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_NAME=aura-redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
QDRANT_IMAGE=qdrant/qdrant:v1.10.1
QDRANT_CONTAINER_NAME=aura-qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Server 2 Brain Integration
AI_SERVER_URL=http://localhost:8001
AI_SERVER_MODEL=qwen/qwen3.8-27b
INTERNAL_API_TOKEN=
